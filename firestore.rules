rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Dashboard data. Any signed-in user (your staff) can read; signed-in users
    // can also write so the seed script works during setup.
    // TIGHTEN for production (e.g. role checks, or lock writes to admins only).
    match /stats/{doc} {
      allow read, write: if request.auth != null;
    }
    match /activity/{doc} {
      allow read, write: if request.auth != null;
    }

    // Everything else: locked.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
