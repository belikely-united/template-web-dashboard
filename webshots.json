{
  "name": "BeLikely Dashboard",
  "version": "2.0.0",
  "node": ">=20",
  "packageManager": "pnpm@9.15.0",
  "commands": { "install": "pnpm install", "dev": "pnpm dev", "build": "pnpm build", "seed": "pnpm seed" },
  "config": "webshots.config.json",
  "brand": { "name": "brand.name", "logo": "brand.logo", "accent": "brand.accent" },
  "tools": { "framework": "nextjs", "auth": "firebase_auth", "db": "firestore", "hosting": "firebase_app_hosting" },
  "blueprints": {
    "saas-dashboard": {
      "built": ["screens/sign-in", "screens/dashboard-home"],
      "partial": {
        "screens/empty-loading": "A full-page loading state and sample data until real data exists; no per-table empty states yet."
      },
      "toggles": {}
    },
    "internal": {
      "built": ["screens/dashboard"],
      "partial": {
        "screens/sign-in-sso": "Email/password and Google sign-in; no SSO yet."
      },
      "toggles": {}
    }
  },
  "env": {
    "firebase_auth": [
      "NEXT_PUBLIC_FIREBASE_API_KEY", "NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN", "NEXT_PUBLIC_FIREBASE_PROJECT_ID",
      "NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET", "NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID", "NEXT_PUBLIC_FIREBASE_APP_ID"
    ]
  }
}
